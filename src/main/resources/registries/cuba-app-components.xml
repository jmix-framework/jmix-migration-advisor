<?xml version="1.0" encoding="UTF-8"?>
<!--
    Known CUBA app components (add-ons) with notes about their availability in Jmix.
    Attributes:
      package - app component base package as listed in web.xml 'appComponents'
      type    - base-app | addon | translation-addon | theme
      origin  - framework | external
-->
<cuba-app-components>
    <component package="com.haulmont.cuba" name="Application" type="base-app" origin="framework">
        <notes>CUBA base application</notes>
    </component>
    <component package="com.haulmont.reports" name="Reporting" type="addon" origin="framework">
        <notes>Available for Jmix</notes>
    </component>
    <component package="com.haulmont.fts" name="Full Text Search" type="addon" origin="framework">
        <notes>Search add-on has been reworked in Jmix</notes>
    </component>
    <component package="com.haulmont.addon.maps" name="Maps" type="addon" origin="framework">
        <notes>Available for Jmix</notes>
    </component>
    <component package="com.haulmont.webdav" name="WebDAV" type="addon" origin="framework">
        <notes>Available for Jmix</notes>
    </component>
    <component package="com.haulmont.addon.grapesjs" name="GrapesJS HTML Editor" type="addon" origin="framework">
        <notes>Unavailable as a standalone add-on. A GrapesJS editor is bundled inside the Message Templates add-on</notes>
    </component>
    <component package="com.haulmont.addon.bproc" name="BProc" type="addon" origin="framework">
        <notes>Available for Jmix</notes>
    </component>
    <component package="com.haulmont.bpm" name="BPM" type="addon" origin="framework">
        <notes>Legacy business process management add-on. Jmix BPM is similar to CUBA BProc</notes>
    </component>
    <component package="com.haulmont.addon.restapi" name="REST API" type="addon" origin="framework">
        <notes>Available for Jmix</notes>
    </component>
    <component package="com.haulmont.charts" name="Charts" type="addon" origin="framework">
        <notes>Available for Jmix</notes>
    </component>
    <component package="com.haulmont.addon.helium" name="Helium Theme" type="theme" origin="framework">
        <notes></notes>
    </component>
    <component package="com.haulmont.addon.ldap" name="LDAP" type="addon" origin="framework">
        <notes>Available for Jmix</notes>
    </component>
    <component package="com.haulmont.addon.globalevents" name="Global Events" type="addon" origin="framework">
        <notes>Jmix allows to send events from backend to UI sessions</notes>
    </component>
    <component package="gr.netmechanics.cuba.afs" name="Azure File Storage" type="addon" origin="external">
        <notes>Unavailable for Jmix</notes>
    </component>
    <component package="ro.infoexpert.cuba.translationro" name="Romanian Translation" type="translation-addon" origin="external">
        <notes></notes>
    </component>
    <component package="gr.netmechanics.cuba.translationel" name="Greek Translation" type="translation-addon" origin="external">
        <notes>Available for Jmix</notes>
    </component>
    <component package="it.nexbit.cuba.translationit" name="Italian Translation" type="translation-addon" origin="external">
        <notes>Available for Jmix</notes>
    </component>
    <component package="de.balvi.cuba.translationde" name="German Translation" type="translation-addon" origin="external">
        <notes>Available for Jmix</notes>
    </component>
    <component package="br.com.petersonbr.translations" name="CUBA Translations" type="translation-addon" origin="external">
        <notes>Check Jmix add-ons marketplace to see available translations</notes>
    </component>
    <component package="cn.cuba.trans" name="Simplified Chinese Translation" type="translation-addon" origin="framework">
        <notes>Available for Jmix</notes>
    </component>
</cuba-app-components>
